// Local dev uses SQLite (see datasource below). Switch "provider" to
// "postgresql" and DATABASE_URL to a real Postgres connection string when
// you deploy to production — the schema itself is Postgres-compatible.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum MovementType {
  PURCHASE_IN
  SALE_OUT
  ADJUSTMENT
}

model Tenant {
  id             String          @id @default(cuid())
  name           String
  country        String          @default("LB")
  currency       String          @default("USD")
  createdAt      DateTime        @default(now())
  memberships    Membership[]
  accounts       Account[]
  journalEntries JournalEntry[]
  customers      Customer[]
  items          Item[]
  orders         Order[]
  purchaseOrders PurchaseOrder[]
  itemMovements  ItemMovement[]
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  createdAt    DateTime     @default(now())
  memberships  Membership[]
}

model Membership {
  id       String @id @default(cuid())
  userId   String
  tenantId String
  role     Role   @default(OWNER)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
}

model Account {
  id        String        @id @default(cuid())
  tenantId  String
  code      String
  name      String
  type      AccountType
  parentId  String?
  createdAt DateTime      @default(now())
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    Account?      @relation("AccountHierarchy", fields: [parentId], references: [id])
  children  Account[]     @relation("AccountHierarchy")
  lines     JournalLine[]
  customer  Customer?

  @@unique([tenantId, code])
}

model JournalEntry {
  id        String        @id @default(cuid())
  tenantId  String
  date      DateTime
  memo      String?
  source    String        @default("manual") // "manual" | "pos" | "payroll"
  createdAt DateTime      @default(now())
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines     JournalLine[]
  order     Order?
  purchaseOrder PurchaseOrder?
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  accountId      String
  debitCents     Int          @default(0)
  creditCents    Int          @default(0)
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id])
}

// A customer known to this business. Each customer gets a dedicated
// sub-account under Accounts Receivable in the chart of accounts, so every
// POS order posts against that specific customer's ledger balance.
model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  accountId String   @unique
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account   Account  @relation(fields: [accountId], references: [id])
  orders    Order[]

  @@unique([tenantId, name])
}

model Item {
  id         String      @id @default(cuid())
  tenantId   String
  name       String
  category   String?
  unit       String      @default("unit")
  priceCents Int
  createdAt  DateTime    @default(now())
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  purchaseLines PurchaseOrderLine[]
  movements  ItemMovement[]

  // Recipe: what this item is made of (sub-items) and, in reverse, which
  // other items use this one as a sub-item.
  components ItemComponent[] @relation("ParentItem")
  usedIn     ItemComponent[] @relation("ComponentItem")
}

// A sub-item / ingredient relationship: `quantity` units of componentItem
// are needed to make one unit of parentItem.
model ItemComponent {
  id              String @id @default(cuid())
  parentItemId    String
  componentItemId String
  quantity        Float
  parentItem      Item   @relation("ParentItem", fields: [parentItemId], references: [id], onDelete: Cascade)
  componentItem   Item   @relation("ComponentItem", fields: [componentItemId], references: [id])

  @@unique([parentItemId, componentItemId])
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  tenantId       String
  supplierName   String
  date           DateTime            @default(now())
  totalCents     Int
  createdAt      DateTime            @default(now())
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines          PurchaseOrderLine[]
  journalEntryId String              @unique
  journalEntry   JournalEntry        @relation(fields: [journalEntryId], references: [id])
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  itemId          String
  quantity        Float
  unitCostCents   Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item            Item          @relation(fields: [itemId], references: [id])
}

// A stock ledger entry — purchases in, sales out, manual adjustments.
// `quantity` is signed: positive for stock coming in, negative for going out.
model ItemMovement {
  id        String       @id @default(cuid())
  tenantId  String
  itemId    String
  type      MovementType
  quantity  Float
  note      String?
  createdAt DateTime     @default(now())
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item      Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Order {
  id             String        @id @default(cuid())
  tenantId       String
  customerId     String
  type           OrderType
  cutlery        String?       // comma-separated selections; only set for TAKEAWAY/DELIVERY
  subtotalCents  Int
  taxCents       Int
  totalCents     Int
  createdAt      DateTime      @default(now())
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer      @relation(fields: [customerId], references: [id])
  items          OrderItem[]
  journalEntryId String        @unique
  journalEntry   JournalEntry  @relation(fields: [journalEntryId], references: [id])
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  itemId     String
  quantity   Int
  priceCents Int
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item       Item   @relation(fields: [itemId], references: [id])
}
