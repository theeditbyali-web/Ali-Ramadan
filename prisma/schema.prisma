generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum MovementType {
  PURCHASE_IN
  SALE_OUT
  ADJUSTMENT
  WASTE_OUT
  PRODUCTION_IN
  PRODUCTION_OUT
}

enum PaymentMethod {
  ON_ACCOUNT
  WHISH
}

enum SettlementMethod {
  CASH
  BANK
  WHISH
}

enum PaymentDirection {
  CUSTOMER_RECEIPT
  SUPPLIER_PAYMENT
}

model Tenant {
  id             String          @id @default(cuid())
  name           String
  country        String          @default("LB")
  currency       String          @default("USD")
  createdAt      DateTime        @default(now())
  memberships    Membership[]
  accounts       Account[]
  journalEntries JournalEntry[]
  customers      Customer[]
  suppliers      Supplier[]
  categories     Category[]
  items          Item[]
  orders         Order[]
  purchaseOrders PurchaseOrder[]
  itemMovements  ItemMovement[]
  payments       Payment[]
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  createdAt    DateTime     @default(now())
  memberships  Membership[]
}

model Membership {
  id       String @id @default(cuid())
  userId   String
  tenantId String
  role     Role   @default(OWNER)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
}

model Account {
  id        String        @id @default(cuid())
  tenantId  String
  code      String
  name      String
  type      AccountType
  parentId  String?
  createdAt DateTime      @default(now())
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    Account?      @relation("AccountHierarchy", fields: [parentId], references: [id])
  children  Account[]     @relation("AccountHierarchy")
  lines     JournalLine[]
  customer  Customer?
  supplier  Supplier?
  category  Category?

  @@unique([tenantId, code])
}

model JournalEntry {
  id        String        @id @default(cuid())
  tenantId  String
  date      DateTime
  memo      String?
  source    String        @default("manual") // "manual" | "pos" | "payroll"
  createdAt DateTime      @default(now())
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines     JournalLine[]
  order     Order?
  purchaseOrder PurchaseOrder?
  payment   Payment?
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  accountId      String
  debitCents     Int          @default(0)
  creditCents    Int          @default(0)
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id])
}

// A customer known to this business. Each customer gets a dedicated
// sub-account under Accounts Receivable in the chart of accounts, so every
// POS order posts against that specific customer's ledger balance.
model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  code      String // e.g. CUST-0001, this customer's ID card number
  name      String
  phone     String?
  email     String?
  address   String?
  accountId String   @unique
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account   Account  @relation(fields: [accountId], references: [id])
  orders    Order[]
  payments  Payment[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
}

// A supplier you buy items from. Each gets an ID card of its own,
// mirroring the customer card.
model Supplier {
  id             String          @id @default(cuid())
  tenantId       String
  code           String // e.g. SUP-0001
  name           String
  phone          String?
  email          String?
  address        String?
  accountId      String          @unique
  createdAt      DateTime        @default(now())
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account        Account         @relation(fields: [accountId], references: [id])
  purchaseOrders PurchaseOrder[]
  payments       Payment[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
}

model Item {
  id         String      @id @default(cuid())
  tenantId   String
  name       String
  categoryId String?
  unit       String      @default("unit")
  sellable   Boolean     @default(true) // shown at the POS register when true
  reorderPoint Float?    // flag as low stock when stock on hand falls to/below this
  priceCents Int
  createdAt  DateTime    @default(now())
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category   Category?   @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
  purchaseLines PurchaseOrderLine[]
  movements  ItemMovement[]

  // Recipe: what this item is made of (sub-items) and, in reverse, which
  // other items use this one as a sub-item.
  components ItemComponent[] @relation("ParentItem")
  usedIn     ItemComponent[] @relation("ComponentItem")
  milkChoices OrderItem[] @relation("OrderItemMilkChoice")
}

// An item category (e.g. "Pure Coffee", "Bakery"). When a category has
// sellable items, it gets a dedicated revenue account under 701 in the
// chart of accounts, so POS sales post to the right category's account.
model Category {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  accountId String?  @unique
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account   Account? @relation(fields: [accountId], references: [id])
  items     Item[]

  @@unique([tenantId, name])
}

// A sub-item / ingredient relationship: `quantity` units of componentItem
// are needed to make one unit of parentItem.
model ItemComponent {
  id              String @id @default(cuid())
  parentItemId    String
  componentItemId String
  quantity        Float
  parentItem      Item   @relation("ParentItem", fields: [parentItemId], references: [id], onDelete: Cascade)
  componentItem   Item   @relation("ComponentItem", fields: [componentItemId], references: [id])

  @@unique([parentItemId, componentItemId])
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  tenantId       String
  supplierId     String
  date           DateTime            @default(now())
  totalCents     Int
  createdAt      DateTime            @default(now())
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  lines          PurchaseOrderLine[]
  journalEntryId String              @unique
  journalEntry   JournalEntry        @relation(fields: [journalEntryId], references: [id])
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  itemId          String
  quantity        Float
  unitCostCents   Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item            Item          @relation(fields: [itemId], references: [id])
}

// A stock ledger entry — purchases in, sales out, manual adjustments.
// `quantity` is signed: positive for stock coming in, negative for going out.
model ItemMovement {
  id        String       @id @default(cuid())
  tenantId  String
  itemId    String
  type      MovementType
  quantity  Float
  note      String?
  createdAt DateTime     @default(now())
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item      Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Order {
  id             String        @id @default(cuid())
  tenantId       String
  customerId     String
  type           OrderType
  paymentMethod  PaymentMethod @default(ON_ACCOUNT)
  cutlery        String?       // comma-separated selections; only set for TAKEAWAY/DELIVERY
  discountCents  Int           @default(0)
  subtotalCents  Int
  taxCents       Int
  totalCents     Int
  refundedAt     DateTime?
  createdAt      DateTime      @default(now())
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer      @relation(fields: [customerId], references: [id])
  items          OrderItem[]
  journalEntryId String        @unique
  journalEntry   JournalEntry  @relation(fields: [journalEntryId], references: [id])
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  itemId     String
  quantity   Int
  priceCents Int
  milkItemId String? // overrides the recipe's default milk ingredient for stock deduction
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item       Item   @relation(fields: [itemId], references: [id])
  milkItem   Item?  @relation("OrderItemMilkChoice", fields: [milkItemId], references: [id])
}

// Settles part or all of a customer's receivable balance, or a payment you
// make toward a supplier's payable balance. Always posts a journal entry
// against Cash/Bank/Whish and the specific customer's or supplier's account.
model Payment {
  id             String           @id @default(cuid())
  tenantId       String
  direction      PaymentDirection
  customerId     String?
  supplierId     String?
  method         SettlementMethod
  amountCents    Int
  date           DateTime         @default(now())
  note           String?
  createdAt      DateTime         @default(now())
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer?        @relation(fields: [customerId], references: [id])
  supplier       Supplier?        @relation(fields: [supplierId], references: [id])
  journalEntryId String           @unique
  journalEntry   JournalEntry     @relation(fields: [journalEntryId], references: [id])
}
